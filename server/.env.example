PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/wondu?replicaSet=rs0
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_SECONDS=3600
COOKIE_SECURE=false
ALLOW_DEMO_SEED=false
DEMO_ADMIN_NAME=Wondu Demo Admin
DEMO_ADMIN_EMAIL=admin@wondu.example
DEMO_ADMIN_PASSWORD=replace-with-a-strong-demo-password
# NEW: required only by the development seed, shared by guide1 ... guide6.
DEMO_GUIDE_PASSWORD=replace-with-a-strong-guide-demo-password
# Optional existing test setting, never use a real user database:
# TEST_MONGODB_URI=mongodb://127.0.0.1:27017/wondu_test?replicaSet=rs0
