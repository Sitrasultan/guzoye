PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/wondu
CLIENT_ORIGIN=http://localhost:5173
# Reserved for Phase 3. No JWTs are issued or accepted in Phase 2.
JWT_SECRET=replace-with-a-long-random-secret-before-phase-3
# Seed is explicitly opt-in. Keep false except while seeding a development DB.

ALLOW_DEMO_SEED=true