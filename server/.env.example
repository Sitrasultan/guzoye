PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/wondu
CLIENT_ORIGIN=http://localhost:5173
# REQUIRED: generate with node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_SECONDS=3600
# false for localhost HTTP; production requires true and HTTPS.
COOKIE_SECURE=false
ALLOW_DEMO_SEED=false
# Only used by the opt-in seed. No public admin registration exists.
DEMO_ADMIN_NAME=Wondu Demo Admin
DEMO_ADMIN_EMAIL=admin@wondu.example
DEMO_ADMIN_PASSWORD=replace-with-a-strong-demo-password
# Optional: tests refuse names without wondu and test; never use a real DB.
# TEST_MONGODB_URI=mongodb://127.0.0.1:27017/wondu_auth_test
